<UserControl x:Class="FleetPro.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F7FA"
          Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="FleetPro Dashboard"
                       FontSize="30"
                       FontWeight="Bold"/>

            <TextBlock FontSize="16"
                       Foreground="Gray"
                       Margin="0,6,0,0">

                <Run Text="Welcome, "/>
                <Run Text="{Binding Username}"/>
                <Run Text="  •  "/>
                <Run Text="{Binding Role}"/>

            </TextBlock>

        </StackPanel>


        <!-- Statistics -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,25">

            <Border Background="White"
                    Padding="20"
                    Margin="5">

                <StackPanel>

                    <TextBlock Text="Total Vehicles"
                               Foreground="Gray"/>

                    <TextBlock Text="{Binding TotalVehicles}"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <Border Background="White"
                    Padding="20"
                    Margin="5">

                <StackPanel>

                    <TextBlock Text="Active Vehicles"
                               Foreground="Gray"/>

                    <TextBlock Text="{Binding ActiveVehicles}"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <Border Background="White"
                    Padding="20"
                    Margin="5">

                <StackPanel>

                    <TextBlock Text="Under Maintenance"
                               Foreground="Gray"/>

                    <TextBlock Text="{Binding VehiclesUnderMaintenance}"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <Border Background="White"
                    Padding="20"
                    Margin="5">

                <StackPanel>

                    <TextBlock Text="Pending Requests"
                               Foreground="Gray"/>

                    <TextBlock Text="{Binding PendingMaintenance}"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

        </UniformGrid>


        <!-- Welcome area -->
        <Border Grid.Row="2"
                Background="White"
                Padding="30"
                Margin="5">

            <StackPanel>

                <TextBlock Text="FleetPro is ready"
                           FontSize="24"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Fleet management modules will appear here as the system is developed."
                           FontSize="15"
                           Foreground="Gray"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>