<UserControl x:Class="FleetPro.WPF.Views.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F7FA"
          Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,20">

            <StackPanel DockPanel.Dock="Left">

                <TextBlock Text="Vehicles"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Manage and monitor fleet vehicles"
                           Foreground="Gray"
                           FontSize="15"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Content="+ Add Vehicle"
                    Command="{Binding AddVehicleCommand}"
                    DockPanel.Dock="Right"
                    Width="135"
                    Height="40"/>

        </DockPanel>


        <!-- SEARCH -->

        <Border Grid.Row="1"
                Background="White"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Height="40"
                         Padding="10"
                         Text="{Binding SearchText,
                                UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>

            </Grid>

        </Border>


        <!-- CONTENT -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2.2*"/>

                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>


            <!-- VEHICLE LIST -->

            <Border Grid.Column="0"
                    Background="White"
                    Padding="15"
                    Margin="0,0,10,0">

                <DataGrid ItemsSource="{Binding Vehicles}"
                          SelectedItem="{Binding SelectedVehicle,
                                          Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="Registration"
                            Binding="{Binding RegistrationNumber}"
                            Width="140"/>

                        <DataGridTextColumn
                            Header="Brand"
                            Binding="{Binding Brand}"
                            Width="110"/>

                        <DataGridTextColumn
                            Header="Model"
                            Binding="{Binding Model}"
                            Width="110"/>

                        <DataGridTextColumn
                            Header="Type"
                            Binding="{Binding VehicleType}"
                            Width="100"/>

                        <DataGridTextColumn
                            Header="Branch"
                            Binding="{Binding Branch}"
                            Width="110"/>

                        <DataGridTextColumn
                            Header="Mileage"
                            Binding="{Binding CurrentMileage}"
                            Width="100"/>

                        <DataGridTextColumn
                            Header="Status"
                            Binding="{Binding Status}"
                            Width="130"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>


            <!-- DETAILS -->

            <Border Grid.Column="1"
                    Background="White"
                    Padding="25"
                    Margin="10,0,0,0">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Vehicle Details"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Select a vehicle from the list"
                                   Foreground="Gray"
                                   Margin="0,5,0,25"/>


                        <!-- Registration -->

                        <TextBlock Text="Registration Number"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.RegistrationNumber}"
                            FontSize="16"
                            Margin="0,4,0,15"/>


                        <!-- Brand / Model -->

                        <TextBlock Text="Brand"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.Brand}"
                            Margin="0,4,0,12"/>


                        <TextBlock Text="Model"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.Model}"
                            Margin="0,4,0,12"/>


                        <!-- Type -->

                        <TextBlock Text="Vehicle Type"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.VehicleType}"
                            Margin="0,4,0,12"/>


                        <!-- Branch -->

                        <TextBlock Text="Branch"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.Branch}"
                            Margin="0,4,0,12"/>


                        <!-- Year -->

                        <TextBlock Text="Manufacturing Year"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.ManufacturingYear}"
                            Margin="0,4,0,12"/>


                        <!-- Fuel -->

                        <TextBlock Text="Fuel Type"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.FuelType}"
                            Margin="0,4,0,12"/>


                        <!-- Transmission -->

                        <TextBlock Text="Transmission"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.Transmission}"
                            Margin="0,4,0,12"/>


                        <!-- Mileage -->

                        <TextBlock Text="Current Mileage"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.CurrentMileage}"
                            Margin="0,4,0,12"/>


                        <!-- Color -->

                        <TextBlock Text="Color"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.Color}"
                            Margin="0,4,0,12"/>


                        <!-- VIN -->

                        <TextBlock Text="VIN"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.VIN}"
                            Margin="0,4,0,12"/>


                        <!-- Engine -->

                        <TextBlock Text="Engine Number"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.EngineNumber}"
                            Margin="0,4,0,12"/>


                        <!-- Purchase -->

                        <TextBlock Text="Purchase Date"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.PurchaseDate}"
                            Margin="0,4,0,12"/>


                        <TextBlock Text="Purchase Price"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.PurchasePrice,
                                           StringFormat={}{0:N2}}"
                            Margin="0,4,0,12"/>


                        <!-- Status -->

                        <TextBlock Text="Status"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedVehicle.Status}"
                            FontWeight="SemiBold"
                            Margin="0,4,0,20"/>


                        <!-- Actions -->

                        <StackPanel Orientation="Horizontal">

                            <Button Content="Edit"
                                    Command="{Binding EditVehicleCommand}"
                                    CommandParameter="{Binding SelectedVehicle}"
                                    Width="90"
                                    Height="38"
                                    Margin="0,0,10,0"
                                    IsEnabled="{Binding HasSelectedVehicle}"/>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>