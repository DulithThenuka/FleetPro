<UserControl x:Class="FleetPro.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="500"
             MinHeight="600">

    <Grid Background="#F5F7FA">

        <Border Width="420"
                Padding="40"
                Background="White"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="FleetPro"
                           FontSize="34"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Fleet Management System"
                           FontSize="16"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,35"/>

                <TextBlock Text="Username"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="42"
                         Padding="10"
                         Margin="0,0,0,20"/>

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <PasswordBox Height="42"
                             Padding="10"
                             Margin="0,0,0,25"/>

                <Button Content="Sign In"
                        Command="{Binding LoginCommand}"
                        Height="45"
                        FontSize="16"
                        FontWeight="SemiBold"/>

                <TextBlock Text="{Binding LoginMessage}"
                           Margin="0,18,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>