<UserControl x:Class="FleetPro.WPF.Views.CompleteAssignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="End Vehicle Assignment"
                   FontSize="28"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="1"
                   Text="Complete the current driver-vehicle assignment."
                   Foreground="#6B7280"
                   Margin="0,5,0,25"/>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,20">

            <StackPanel>

                <TextBlock Text="Driver"
                           FontWeight="SemiBold"/>

                <TextBlock Text="{Binding DriverName}"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,5,0,12"/>

                <TextBlock Text="Vehicle"
                           FontWeight="SemiBold"/>

                <TextBlock Text="{Binding VehicleName}"
                           FontSize="18"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,0,0,15">

            <TextBlock Text="End Date"
                       FontWeight="SemiBold"/>

            <DatePicker SelectedDate="{Binding EndDate}"
                        Height="40"
                        Margin="0,6,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0,0,0,15">

            <TextBlock Text="End Mileage"
                       FontWeight="SemiBold"/>

            <TextBox Text="{Binding EndMileage, UpdateSourceTrigger=PropertyChanged}"
                     Height="40"
                     Margin="0,6,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="5">

            <TextBlock Text="Notes"
                       FontWeight="SemiBold"/>

            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     Height="90"
                     Margin="0,6,0,15"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>

            <TextBlock Text="{Binding FormMessage}"
                       Foreground="#B91C1C"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Padding="18,10"
                        Margin="0,0,10,0"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Complete Assignment"
                        Padding="18,10"
                        Command="{Binding SaveCommand}"/>

            </StackPanel>

        </StackPanel>

    </Grid>

</UserControl>