<UserControl x:Class="FleetPro.WPF.Views.MainShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F7FA">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="#172033">

            <DockPanel>

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="25,25,25,35">

                    <TextBlock Text="FleetPro"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Fleet Management"
                               Foreground="#AAB4C3"
                               FontSize="13"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="15,0">

                        <TextBlock Text="MAIN"
                                   Foreground="#7F8CA3"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="10,0,0,10"/>


                        <Button Content="Dashboard"
                                Command="{Binding ShowDashboardCommand}"
                                Height="45"
                                Margin="0,0,0,5"
                                HorizontalContentAlignment="Left"
                                Padding="15,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>


                        <Button Content="Vehicles"
                                Command="{Binding ShowVehiclesCommand}"
                                Height="45"
                                Margin="0,0,0,5"
                                HorizontalContentAlignment="Left"
                                Padding="15,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>


                        <TextBlock Text="OPERATIONS"
                                   Foreground="#7F8CA3"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="10,25,0,10"/>


                        <Button Content="Drivers"
                                Height="45"
                                Margin="0,0,0,5"
                                HorizontalContentAlignment="Left"
                                Padding="15,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>


                        <Button Content="Maintenance"
                                Height="45"
                                Margin="0,0,0,5"
                                HorizontalContentAlignment="Left"
                                Padding="15,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>


                        <Button Content="Workshop"
                                Height="45"
                                Margin="0,0,0,5"
                                HorizontalContentAlignment="Left"
                                Padding="15,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>


                        <Button Content="Inventory"
                                Height="45"
                                Margin="0,0,0,5"
                                HorizontalContentAlignment="Left"
                                Padding="15,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>


                        <Button Content="Fuel"
                                Height="45"
                                Margin="0,0,0,5"
                                HorizontalContentAlignment="Left"
                                Padding="15,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>


                        <Button Content="Accidents"
                                Height="45"
                                Margin="0,0,0,5"
                                HorizontalContentAlignment="Left"
                                Padding="15,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>


                        <TextBlock Text="BUSINESS"
                                   Foreground="#7F8CA3"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="10,25,0,10"/>


                        <Button Content="Finance"
                                Height="45"
                                Margin="0,0,0,5"
                                HorizontalContentAlignment="Left"
                                Padding="15,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>


                        <Button Content="Reports"
                                Height="45"
                                Margin="0,0,0,5"
                                HorizontalContentAlignment="Left"
                                Padding="15,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>

                    </StackPanel>

                </ScrollViewer>


                <!-- User -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="#2C374A"
                        BorderThickness="0,1,0,0"
                        Padding="18">

                    <StackPanel>

                        <TextBlock Text="{Binding Username}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>

                        <TextBlock Text="{Binding Role}"
                                   Foreground="#AAB4C3"
                                   FontSize="12"
                                   Margin="0,3,0,10"/>

                        <Button Content="Logout"
                                Height="35"
                                HorizontalContentAlignment="Left"
                                Padding="10,0"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"/>

                    </StackPanel>

                </Border>

            </DockPanel>

        </Border>


        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">

            <ContentControl Content="{Binding CurrentPage}"/>

        </Grid>

    </Grid>

</UserControl>