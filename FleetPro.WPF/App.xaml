<Application x:Class="FleetPro.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FleetPro.WPF.Views"
             xmlns:viewModels="clr-namespace:FleetPro.WPF.ViewModels">

    <Application.Resources>

        <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:MainShellViewModel}">
            <views:MainShellView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:VehiclesViewModel}">
            <views:VehiclesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:VehicleFormViewModel}">
            <views:VehicleFormView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:DriversViewModel}">
            <views:DriversView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:DriverFormViewModel}">
            <views:DriverFormView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:VehicleAssignmentViewModel}">
            <views:VehicleAssignmentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CompleteAssignmentViewModel}">
            <views:CompleteAssignmentView />
        </DataTemplate>

    </Application.Resources>

</Application>